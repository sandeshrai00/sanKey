#!/bin/bash
# Sorakey installer — builds daemon, installs soundpacks, starts service.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(dirname "$SCRIPT_DIR")"
DAEMON_DIR="$PLUGIN_DIR/daemon"

BIN="$HOME/.local/bin/sorakey"
SHARE="$HOME/.local/share/sorakey"
UNIT_DIR="$HOME/.config/systemd/user"
UNIT="$UNIT_DIR/sorakey.service"

step() { printf '\n\033[1m== %s ==\033[0m\n' "$*"; }
die()  { printf '\n\033[1;31msorakey-setup: %s\033[0m\n' "$*" >&2; exit 1; }

# 1. Build daemon
[[ -d "$DAEMON_DIR" ]] || die "daemon/ not found next to this script"
step "Building sorakey (verified prebuilt if available, else source)"
"$PLUGIN_DIR/scripts/build-sorakey.sh" || die "build failed"

# 2. Install soundpacks
step "Installing soundpacks"
mkdir -p "$SHARE/soundpacks"
cp -rn "$DAEMON_DIR/soundpacks/." "$SHARE/soundpacks/" 2>/dev/null || true

# 3. systemd service
step "Installing the sorakey user service"
mkdir -p "$UNIT_DIR"
cat > "$UNIT" <<'EOF'
[Unit]
Description=Sorakey keyboard sound daemon

[Service]
Type=simple
ExecStart=%h/.local/bin/sorakey
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
EOF
systemctl --user daemon-reload
systemctl --user enable --now sorakey || die "could not start the sorakey service"

# 4. input group
step "Checking input group (keyboard capture)"
if id -nG "$USER" | tr ' ' '\n' | grep -qx input; then
  echo "input group: OK"
else
  echo
  echo "You are NOT in the 'input' group, so keyboard sounds need one"
  echo "privileged step. Run this in your terminal, then log out and back in:"
  echo
  echo "    sudo usermod -aG input $USER"
fi

if command -v omarchy >/dev/null 2>&1; then
  echo "Bar icon position: configure anytime in Sorakey panel → POSITION (or: omarchy plugin enable io.github.sandeshrai00.sorakey --section left|center|right)"
fi

step "Done"
echo "Sorakey is installed and running. Open the Sorakey bar panel to tune it."
echo "Type a few keys — you should hear them."